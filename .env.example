# MYSHIFT Environment Configuration
# Copy values from the shared .env at MOCHIKIN-APPS/ (Google service account creds).
# Generate MYSHIFT_API_KEY with at least 32 random characters.

# Core app
MYSHIFT_API_KEY=YOUR_32_CHARACTER_RANDOM_KEY_HERE

# Google Service Account (required for Sheets API)
# These are provided from the shared workspace .env; do not commit real keys.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=stokis-service@stokis-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=...

# Registry spreadsheet (filled after running `pnpm run setup:sheets`)
REGISTRY_SPREADSHEET_ID=
TEMPLATE_SPREADSHEET_ID=

# Shared Drive folder used when seeding new branch spreadsheets
MYSHIFT_SHARED_DRIVE_ID=
MYSHIFT_FOLDER=

# Optional: init admin seeding on first setup
# MYSHIFT_INIT_PIN=<6-digit-pin>   # only needed for seeding a default admin
# MYSHIFT_INIT_NAME=Admin Pusat   # default admin name
# MYSHIFT_INIT_BRANCH=CBG001      # default cabang

# Required by scripts/seed-dummy-data.ts (dummy PINs are never committed in plaintext)
# MYSHIFT_SEED_PIN=<6-digit-pin>

# Optional: PIN for scripts/update-admin-pin.ts (otherwise pass it as the first CLI argument)
# MYSHIFT_NEW_PIN=<6-digit-pin>
