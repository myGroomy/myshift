# MYSHIFT Environment Configuration
# Copy values from the shared .env at MOCHIKIN-APPS/ (Google service account creds).
# Generate MYSHIFT_API_KEY with at least 32 random characters.

# Core app
MYSHIFT_API_KEY=YOUR_32_CHARACTER_RANDOM_KEY_HERE

# Google Service Account (required for Sheets API + Drive copy)
# These are provided from the shared workspace .env; do not commit real keys.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=stokis-service@stokis-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=...

# Registry spreadsheet (central database: Daftar_Cabang, Employees, Settings_Global)
# Fill after running `pnpm run setup:sheets` or manually from Google Sheets
REGISTRY_SPREADSHEET_ID=

# Template cabang TIDAK dikonfigurasi lewat env. Sumber tunggalnya sheet `TEMPLATES` di dalam
# registry spreadsheet (kolom A = Template_Spreadsheet_ID, kolom B = Parent_Folder_ID) —
# lihat PLAN/SHEETS-SCHEMA.md §1-§2.
# Langkah:
#   1. `pnpm template:branch` -> menghasilkan PLAN/templates/MYSHIFT-Template-Cabang.xlsx
#   2. Upload .xlsx itu ke folder MYSHIFT di Drive
#   3. `pnpm template:import -- --source=<fileId .xlsx>` -> mengonversi jadi Google Sheet
#   4. Isi kolom A & B di sheet `TEMPLATES` dengan ID hasil import dan ID folder MYSHIFT
#      Bagikan keduanya ke service account (GOOGLE_SERVICE_ACCOUNT_EMAIL) sebagai Editor

# Optional: init admin seeding on first setup
# MYSHIFT_INIT_PIN=<6-digit-pin>
# MYSHIFT_INIT_NAME=Admin Pusat
# MYSHIFT_INIT_BRANCH=CBG001

# PIN untuk scripts (seed-dummy-data.ts, update-admin-pin.ts)
# PIN ini HANYA untuk development/local. Tidak pernah commit plaintext PIN!
# MYSHIFT_SEED_PIN=<6-digit-pin>
# MYSHIFT_NEW_PIN=<6-digit-pin>

# Apps Script Drive bridge (Wajib untuk provisioning cabang + upload foto checklist).
# Tanpa dua variabel ini, POST /api/branches dan upload foto berhenti dengan
# SHEETS_SETUP_REQUIRED sebelum menyentuh Drive (lib/google/drive-bridge.ts).
# Isi: gas/README.md URL deployment Web App (.../exec) dan secret yang sama dengan
# Script Property MYSHIFT_BRIDGE_SECRET (hasil `openssl rand -hex 32`).
GAS_DRIVE_BRIDGE_URL=
GAS_BRIDGE_SECRET=
